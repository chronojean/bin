PROGRESS_DRAWN=0

VIDEO_PERCENT="0.0"
AUDIO_PERCENT="0.0"
TOTAL_PERCENT="0.0"

DOWNLOAD_SPEED="--"
DOWNLOAD_ETA="--"

LAST_RENDER_TIME=0

CURRENT_VIDEO_INDEX=""
