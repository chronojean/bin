# ============================================================
# Porcentaje (aritmética entera en bash, sin awk)
#
# Los valores se manejan en escala x10 (ej: 724 = 72.4%) para
# conservar un decimal sin depender de awk ni de flotantes.
# yt-dlp emite muchos eventos de progreso por segundo, así que
# evitar un fork externo por cálculo es una optimización real.
# ============================================================

calculate_percent() {

    local downloaded="$1"
    local total="$2"

    if [[ "$downloaded" =~ ^[0-9]+$ ]] &&
       [[ "$total" =~ ^[0-9]+$ ]] &&
       (( total > 0 )); then

        local x10=$(( downloaded * 1000 / total ))
        printf '%d.%d' "$((x10 / 10))" "$((x10 % 10))"

    else
        printf '0.0'
    fi
}

clamp_percent() {

    local value="$1"
    local sign=""

    if [[ "$value" == -* ]]; then
        sign="-"
        value="${value#-}"
    fi

    local x10="${value/./}"
    x10=$((10#$x10))

    [[ -n "$sign" ]] && x10=$(( -x10 ))

    (( x10 < 0 )) && x10=0
    (( x10 > 1000 )) && x10=1000

    printf '%d.%d' "$((x10 / 10))" "$((x10 % 10))"
}

# ============================================================
# Barra
# ============================================================

make_bar() {

    local percent="$1"
    local color="$2"

    local x10="${percent/./}"
    x10=$((10#$x10))

    local filled=$(( (x10 * BAR_WIDTH + 500) / 1000 ))
    local empty
    local i

    (( filled < 0 )) && filled=0
    (( filled > BAR_WIDTH )) && filled=$BAR_WIDTH

    empty=$((BAR_WIDTH - filled))

    printf "${color}"

    for ((i = 0; i < filled; i++)); do
        printf "█"
    done

    printf "${GRAY}"

    for ((i = 0; i < empty; i++)); do
        printf "░"
    done

    printf "${RESET}"
}

# ============================================================
# Redibujado del progreso
#
# Se usa desplazamiento RELATIVO del cursor (\033[nA) en vez de
# guardar/restaurar una posición absoluta (tput sc/rc, DECSC/
# DECRC). El guardado absoluto se invalida en cuanto la terminal
# hace scroll entre el guardado y la restauración —y aquí es
# casi seguro que ya ocurrió scroll antes de llegar a esta
# pantalla (menús, verificaciones, resumen de configuración).
# El desplazamiento relativo, en cambio, solo depende de dónde
# está el cursor en este momento, así que es inmune a cuánto
# haya hecho scroll la terminal en el pasado.
#
# Cada línea se limpia por completo (\033[2K\r) antes de
# reescribirla, y si el frame nuevo tiene menos líneas que el
# anterior (la ventana de la playlist puede variar), las líneas
# sobrantes se blanquean explícitamente para no dejar restos.
# ============================================================

progress_move_up() {
    local lines="$1"
    (( lines > 0 )) && printf '\033[%dA' "$lines"
}

progress_clear_trailing() {

    local previous_lines="$1"
    local new_lines="$2"

    if (( new_lines < previous_lines )); then

        local extra=$(( previous_lines - new_lines ))
        local k

        for ((k = 0; k < extra; k++)); do
            printf '\033[2K\r\n'
        done

        progress_move_up "$extra"
    fi
}

# ============================================================
# Ancho de terminal
#
# Se consulta una vez por descarga (no por cada evento de
# progreso) para acotar el largo de los títulos de la playlist
# y evitar que una línea envuelva a una segunda fila visual,
# lo que rompería el conteo de líneas del redibujado.
# ============================================================

get_terminal_width() {

    local cols

    cols="$(tput cols 2>/dev/null)"

    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80

    printf '%d' "$cols"
}

# ============================================================
# Inicializar pantalla de progreso
# ============================================================

start_progress_screen() {

    PROGRESS_DRAWN=0
    PROGRESS_LINES=0
    LAST_RENDER_TIME=0
    TERM_COLS="$(get_terminal_width)"

    local quality_label
    quality_label="$(format_quality_label)"

    echo

    if [[ "$PLAYLIST_MODE" == "playlist" ]]; then

        printf "${CYAN}┌────────────────────────────────────────────────────────┐${RESET}\n"

        playlist_box_line "📋 ${PLAYLIST_TITLE:0:48}"

        if (( PLAYLIST_COUNT > 0 )); then
            playlist_box_line_split "${PLAYLIST_COUNT} vídeos" "$quality_label"
        else
            playlist_box_line_split "Cantidad no disponible" "$quality_label"
        fi

        printf "${CYAN}└────────────────────────────────────────────────────────┘${RESET}\n"

        echo

    else

        echo -e "${BOLD}${WHITE}Descargando: ${VIDEO_TITLE}${RESET}"
        echo -e "${DIM}Calidad:${RESET} ${GREEN}${quality_label}${RESET}"
        echo

    fi
}

# ============================================================
# Render vídeo individual
# ============================================================

render_single_progress() {

    local video="$1"
    local audio="$2"
    local total="$3"
    local speed="$4"
    local eta="$5"

    local video_bar
    local audio_bar
    local total_bar

    video_bar="$(make_bar "$video" "$CYAN")"
    audio_bar="$(make_bar "$audio" "$MAGENTA")"
    total_bar="$(make_bar "$total" "$GREEN")"

    if (( PROGRESS_DRAWN )); then
        progress_move_up "$PROGRESS_LINES"
    fi

    printf "\033[2K\r  🎬 Vídeo  %s  %5.1f%%\n" \
        "$video_bar" "$video"

    printf "\033[2K\r  🎵 Audio  %s  %5.1f%%\n" \
        "$audio_bar" "$audio"

    printf "\033[2K\r  ⚡ Total  %s  %5.1f%%\n" \
        "$total_bar" "$total"

    printf "\033[2K\r  ${DIM}Velocidad:${RESET} ${CYAN}%s${RESET}" "$speed"
    printf "    ${DIM}ETA:${RESET} ${YELLOW}%s${RESET}\n" "$eta"

    PROGRESS_LINES=4
    PROGRESS_DRAWN=1
}

# ============================================================
# Preparar estado de playlist
# ============================================================

declare -a PL_INDEX
declare -a PL_TITLE
declare -a PL_STATUS

load_playlist_entries() {

    PL_INDEX=()
    PL_TITLE=()
    PL_STATUS=()

    while IFS=$'\t' read -r idx title; do

        [[ -n "$idx" ]] || continue

        PL_INDEX+=("$idx")
        PL_TITLE+=("$title")
        PL_STATUS+=("pending")

    done < <(
        yt-dlp \
            --flat-playlist \
            --no-warnings \
            --skip-download \
            --print "%(playlist_index)s"$'\t'"%(title)s" \
            "$URL" 2>/dev/null
    )

    # Si yt-dlp no devolvió la lista, al menos usamos la
    # información que ya obtuvimos.
    if (( ${#PL_INDEX[@]} == 0 )) &&
       (( PLAYLIST_COUNT > 0 )); then

        local i

        for ((i = 1; i <= PLAYLIST_COUNT; i++)); do

            PL_INDEX+=("$i")
            PL_TITLE+=("Vídeo $i")
            PL_STATUS+=("pending")

        done
    fi
}

# ============================================================
# Ubicar un vídeo de la playlist por título (o, si no hay
# coincidencia, por índice)
#
# Se usa el título como clave principal porque es el mismo
# dato que yt-dlp necesita para nombrar el archivo de salida,
# así que se actualiza de forma fiable en cada vídeo. El
# %(playlist_index)s del evento de progreso no siempre se
# mantiene consistente con el de la extracción --flat-playlist
# usada para armar PL_INDEX/PL_TITLE (yt-dlp ha cambiado ese
# comportamiento entre versiones), así que solo se usa como
# respaldo cuando el título no encuentra coincidencia.
#
# Devuelve la posición (0-based) por stdout, o -1 si no
# encuentra nada.
# ============================================================

find_playlist_position() {

    local title="$1"
    local index="$2"
    local i

    if [[ -n "$title" ]]; then

        for ((i = 0; i < ${#PL_TITLE[@]}; i++)); do
            if [[ "${PL_TITLE[$i]}" == "$title" ]]; then
                printf '%d' "$i"
                return 0
            fi
        done
    fi

    if [[ "$index" =~ ^[0-9]+$ ]]; then

        for ((i = 0; i < ${#PL_INDEX[@]}; i++)); do
            if [[ "${PL_INDEX[$i]}" == "$index" ]]; then
                printf '%d' "$i"
                return 0
            fi
        done
    fi

    printf '%d' -1
}

# ============================================================
# Ancho visual básico
# ============================================================

truncate_text() {

    local text="$1"
    local max="$2"

    if (( ${#text} <= max )); then
        printf '%s' "$text"
    else
        printf '%s…' "${text:0:max-1}"
    fi
}

# ============================================================
# Render playlist
# ============================================================

render_playlist_progress() {

    local current_index="$1"
    local current_position="$2"
    local total_percent="$3"
    local video_percent="$4"
    local audio_percent="$5"
    local speed="$6"
    local eta="$7"

    local lines=()

    local i
    local idx
    local title
    local status
    local marker

    # --------------------------------------------------------
    # Crear lista
    # --------------------------------------------------------

    for ((i = 0; i < ${#PL_INDEX[@]}; i++)); do

        idx="${PL_INDEX[$i]}"
        title="${PL_TITLE[$i]}"
        status="${PL_STATUS[$i]}"

        case "$status" in

            done)
                marker="${GREEN}✓${RESET}"
                ;;

            downloading)
                marker="${YELLOW}▶${RESET}"
                ;;

            error)
                marker="${RED}✗${RESET}"
                ;;

            *)
                marker="${GRAY}○${RESET}"
                ;;

        esac

        title="$(truncate_text "$title" 43)"

        lines+=(
            "$(printf '  %02d  %s  %s' "$((10#$idx))" "$marker" "$title")"
        )

    done

    # --------------------------------------------------------
    # Si hay demasiados elementos, mostrar una ventana.
    # Esto no cambia la lista lógica.
    #
    # current_position ya viene calculada por quien llama (se
    # determina una sola vez, al detectar el cambio de vídeo,
    # comparando por título -- ver find_playlist_position).
    # --------------------------------------------------------

    local start=0
    local end="${#lines[@]}"

    # Máximo de 18 entradas visibles.
    local max_visible=18

    if (( end > max_visible )); then

        start=$((current_position - 8))

        (( start < 0 )) && start=0

        end=$((start + max_visible))

        if (( end > ${#lines[@]} )); then
            end="${#lines[@]}"
            start=$((end - max_visible))
        fi
    fi

    if (( PROGRESS_DRAWN )); then
        progress_move_up "$PROGRESS_LINES"
    fi

    local new_lines=0

    for ((i = start; i < end; i++)); do
        printf "\033[2K\r%s\n" "${lines[$i]}"
        ((new_lines++))
    done

    if (( start > 0 )); then
        printf "\033[2K\r  ${DIM}↑ más vídeos arriba${RESET}\n"
        ((new_lines++))
    fi

    if (( end < ${#lines[@]} )); then
        printf "\033[2K\r  ${DIM}↓ más vídeos abajo${RESET}\n"
        ((new_lines++))
    fi

    printf "\033[2K\r\n"
    ((new_lines++))

    if (( PLAYLIST_COUNT > 0 )); then
        printf "\033[2K\r  ${BOLD}Vídeo actual:${RESET} %02d / %02d\n" \
            "$((10#$current_index))" "$((10#$PLAYLIST_COUNT))"
    else
        printf "\033[2K\r  ${BOLD}Vídeo actual:${RESET} %02d\n" \
            "$((10#$current_index))"
    fi

    ((new_lines++))

    local bar
    bar="$(make_bar "$total_percent" "$GREEN")"

    printf "\033[2K\r  %s  %5.1f%%\n" \
        "$bar" "$total_percent"

    ((new_lines++))

    printf "\033[2K\r  ${CYAN}video: %.1f%%${RESET} | ${MAGENTA}audio: %.1f%%${RESET} | ${CYAN}%s${RESET} | ${YELLOW}ETA %s${RESET}\n" \
        "$video_percent" \
        "$audio_percent" \
        "$speed" \
        "$eta"

    ((new_lines++))

    progress_clear_trailing "$PROGRESS_LINES" "$new_lines"

    PROGRESS_LINES="$new_lines"
    PROGRESS_DRAWN=1
}

# ============================================================
# Procesar evento de progreso
# ============================================================

process_progress_event() {

    local marker="$1"
    local video_codec="$2"
    local audio_codec="$3"
    local downloaded="$4"
    local total="$5"
    local estimated="$6"
    local speed="$7"
    local eta="$8"

    [[ "$downloaded" =~ ^[0-9]+$ ]] || downloaded=0

    local current_total=0

    if [[ "$total" =~ ^[0-9]+$ ]] &&
       (( total > 0 )); then

        current_total="$total"

    elif [[ "$estimated" =~ ^[0-9]+$ ]] &&
         (( estimated > 0 )); then

        current_total="$estimated"
    fi

    local vp="$VIDEO_PERCENT"
    local ap="$AUDIO_PERCENT"

    if [[ "$video_codec" != "none" &&
          "$audio_codec" == "none" ]]; then

        if (( current_total > 0 )); then
            vp="$(calculate_percent "$downloaded" "$current_total")"
        fi

    elif [[ "$video_codec" == "none" &&
            "$audio_codec" != "none" ]]; then

        if (( current_total > 0 )); then
            ap="$(calculate_percent "$downloaded" "$current_total")"
        fi

    else

        if (( current_total > 0 )); then
            vp="$(calculate_percent "$downloaded" "$current_total")"
            ap="$vp"
        fi
    fi

    vp="$(clamp_percent "$vp")"
    ap="$(clamp_percent "$ap")"

    local vp10 ap10 tp10 tp

    vp10=$((10#${vp/./}))
    ap10=$((10#${ap/./}))
    tp10=$(( (vp10 + ap10) / 2 ))

    tp="$(printf '%d.%d' "$((tp10 / 10))" "$((tp10 % 10))")"

    VIDEO_PERCENT="$vp"
    AUDIO_PERCENT="$ap"
    TOTAL_PERCENT="$(clamp_percent "$tp")"

    # ----------------------------------------------------------
    # Velocidad y ETA ya vienen formateadas por yt-dlp
    # (progress._speed_str / progress._eta_str), con la unidad
    # correcta (KiB/MiB/GiB) y sin necesidad de convertir bytes
    # a mano. Solo se recortan espacios sobrantes que yt-dlp
    # a veces añade para alinear su propia barra.
    # ----------------------------------------------------------

    if [[ -n "$speed" ]]; then
        speed="${speed#"${speed%%[![:space:]]*}"}"
        speed="${speed%"${speed##*[![:space:]]}"}"
        DOWNLOAD_SPEED="$speed"
    fi

    if [[ -n "$eta" ]]; then
        eta="${eta#"${eta%%[![:space:]]*}"}"
        eta="${eta%"${eta##*[![:space:]]}"}"
        DOWNLOAD_ETA="$eta"
    fi

    # ----------------------------------------------------------
    # Limitar el redibujado a ~1 vez por segundo
    #
    # yt-dlp puede emitir decenas de eventos de progreso por
    # segundo. El estado (porcentajes, velocidad, ETA, PL_STATUS)
    # se actualiza en CADA evento arriba, pero la pantalla solo
    # se repinta como máximo una vez por segundo -- eso es lo
    # único que limita la tasa de redibujado.
    # ----------------------------------------------------------

    local now="${EPOCHSECONDS:-$(date +%s)}"

    if (( now - LAST_RENDER_TIME < 1 )); then
        return
    fi

    LAST_RENDER_TIME="$now"

    if [[ "$PLAYLIST_MODE" == "playlist" ]]; then

        render_playlist_progress \
            "${CURRENT_VIDEO_INDEX:-1}" \
            "$CURRENT_VIDEO_POSITION" \
            "$TOTAL_PERCENT" \
            "$VIDEO_PERCENT" \
            "$AUDIO_PERCENT" \
            "$DOWNLOAD_SPEED" \
            "$DOWNLOAD_ETA"

    else

        render_single_progress \
            "$VIDEO_PERCENT" \
            "$AUDIO_PERCENT" \
            "$TOTAL_PERCENT" \
            "$DOWNLOAD_SPEED" \
            "$DOWNLOAD_ETA"

    fi
}

# ============================================================
# Descargar
# ============================================================

download_video() {

    local format
    local progress_fifo
    local error_file
    local yt_pid
    local yt_status

    format="bestvideo[height<=${VIDEO_HEIGHT}]+${AUDIO_SELECTOR}/best[height<=${VIDEO_HEIGHT}]"

    mkdir -p "$DOWNLOAD_DIR"

    VIDEO_PERCENT="0.0"
    AUDIO_PERCENT="0.0"
    TOTAL_PERCENT="0.0"

    DOWNLOAD_SPEED="--"
    DOWNLOAD_ETA="--"

    # --------------------------------------------------------
    # Playlist
    # --------------------------------------------------------

    if [[ "$PLAYLIST_MODE" == "playlist" ]]; then

        load_playlist_entries

        if (( ${#PL_INDEX[@]} == 0 )); then

            warning "No se pudo obtener el contenido de la playlist."
            warning "yt-dlp intentará procesarla directamente."

        fi

    fi

    progress_fifo="$(mktemp -u)"
    error_file="$(mktemp)"

    mkfifo "$progress_fifo"

    # Si el usuario interrumpe la descarga (Ctrl+C), este trap
    # evita dejar el proceso de yt-dlp huérfano y el FIFO/archivo
    # temporal abandonados en /tmp.
    trap '
        [[ -n "$yt_pid" ]] && kill "$yt_pid" 2>/dev/null
        rm -f "$progress_fifo" "$error_file"
        exit 130
    ' INT TERM

    # --------------------------------------------------------
    # Arrancar interfaz
    # --------------------------------------------------------

    start_progress_screen

    # --------------------------------------------------------
    # Opciones
    # --------------------------------------------------------

    local playlist_options=()

    if [[ "$PLAYLIST_MODE" == "single" ]]; then
        playlist_options+=(--no-playlist)
    fi

    # --------------------------------------------------------
    # yt-dlp
    #
    # Importante:
    # --quiet evita que yt-dlp pinte su propio progreso.
    # Nuestro renderer es el único que actualiza la pantalla.
    # --------------------------------------------------------

    yt-dlp \
        "${playlist_options[@]}" \
        --format "$format" \
        --merge-output-format mp4 \
        --output "$DOWNLOAD_DIR/%(title)s.%(ext)s" \
        --newline \
        --quiet \
        --no-warnings \
        --progress \
        --progress-template=$'download:SMV\t%(info.playlist_index)s\t%(info.title)s\t%(info.vcodec)s\t%(info.acodec)s\t%(progress.downloaded_bytes)s\t%(progress.total_bytes)s\t%(progress.total_bytes_estimate)s\t%(progress._speed_str)s\t%(progress._eta_str)s' \
        "$URL" >"$progress_fifo" 2>"$error_file" &

    yt_pid=$!

    # --------------------------------------------------------
    # Leer eventos
    # --------------------------------------------------------

    while IFS=$'\t' read -r \
        marker \
        playlist_index \
        item_title \
        video_codec \
        audio_codec \
        downloaded \
        total \
        estimated \
        speed \
        eta; do

        [[ "$marker" == "SMV" ]] || continue

        # ----------------------------------------------------
        # Playlist: detectar cambio de vídeo
        #
        # Se detecta por TÍTULO, no por playlist_index: el
        # título es el mismo dato que yt-dlp usa para nombrar
        # el archivo de salida, así que se actualiza de forma
        # fiable en cada vídeo. Cuando el título cambia respecto
        # al evento anterior, el vídeo previo ya terminó.
        # ----------------------------------------------------

        if [[ "$PLAYLIST_MODE" == "playlist" &&
              -n "$item_title" &&
              "$item_title" != "NA" &&
              "$item_title" != "$PREVIOUS_VIDEO_KEY" ]]; then

            if (( PREVIOUS_VIDEO_POSITION >= 0 )); then
                PL_STATUS[$PREVIOUS_VIDEO_POSITION]="done"
            fi

            local position
            position="$(find_playlist_position "$item_title" "$playlist_index")"

            if (( position >= 0 )); then

                CURRENT_VIDEO_POSITION="$position"
                CURRENT_VIDEO_INDEX=$((position + 1))
                PL_STATUS[$position]="downloading"

            elif [[ "$playlist_index" =~ ^[0-9]+$ ]]; then

                CURRENT_VIDEO_POSITION=-1
                CURRENT_VIDEO_INDEX=$((10#$playlist_index))

            fi

            PREVIOUS_VIDEO_KEY="$item_title"
            PREVIOUS_VIDEO_POSITION="$CURRENT_VIDEO_POSITION"
            CURRENT_VIDEO_TITLE="$item_title"

            # Nuevo vídeo: los porcentajes del anterior no
            # aplican. Sin este reinicio, el audio se queda
            # mostrando el 100% del vídeo previo hasta que
            # empieza su propia fase de audio (el vídeo sí se
            # reiniciaba solo porque su fase arranca primero).
            VIDEO_PERCENT="0.0"
            AUDIO_PERCENT="0.0"
            TOTAL_PERCENT="0.0"

        fi

        process_progress_event \
            "$marker" \
            "$video_codec" \
            "$audio_codec" \
            "$downloaded" \
            "$total" \
            "$estimated" \
            "$speed" \
            "$eta"

    done <"$progress_fifo"

    wait "$yt_pid"
    yt_status=$?

    rm -f "$progress_fifo"

    # --------------------------------------------------------
    # Marcar el último vídeo como terminado
    #
    # Los vídeos anteriores ya se marcan "done" al detectar el
    # cambio de título dentro del bucle. El último no dispara
    # esa transición (no llega un "siguiente" evento), así que
    # se marca aquí una vez que yt-dlp terminó con éxito.
    # --------------------------------------------------------

    if [[ "$PLAYLIST_MODE" == "playlist" &&
          "$yt_status" -eq 0 &&
          "$CURRENT_VIDEO_POSITION" -ge 0 ]]; then

        PL_STATUS[$CURRENT_VIDEO_POSITION]="done"
    fi

    # --------------------------------------------------------
    # Resultado
    # --------------------------------------------------------

    if (( yt_status == 0 )); then

        if [[ "$PLAYLIST_MODE" == "single" ]]; then

            render_single_progress \
                "100.0" \
                "100.0" \
                "100.0" \
                "completado" \
                "00:00"

        else

            render_playlist_progress \
                "${CURRENT_VIDEO_INDEX:-1}" \
                "$CURRENT_VIDEO_POSITION" \
                "100.0" \
                "100.0" \
                "100.0" \
                "completado" \
                "00:00"

        fi

        echo
        success "✓ Descarga completada."
        echo
        echo "Guardado en:"
        echo "  $DOWNLOAD_DIR"
        echo

        rm -f "$error_file"

        return 0

    fi

    # --------------------------------------------------------
    # Error
    # --------------------------------------------------------

    echo

    error "La descarga ha fallado."

    if [[ -s "$error_file" ]]; then

        echo
        cat "$error_file"

    fi

    rm -f "$error_file"

    return "$yt_status"
}

# ============================================================
# Reintentos
# ============================================================

download_loop() {

    while true; do

        if download_video; then
            return 0
        fi

        echo
        echo -e "${BOLD}¿Qué deseas hacer?${RESET}"
        echo
        echo "  1) Reintentar descarga"
        echo "  2) Salir"
        echo

        while true; do

            read -r -p "Selecciona [1-2]: " retry

            case "$retry" in

                1)
                    echo
                    msg "Reintentando descarga..."
                    echo
                    break
                    ;;

                2)
                    warning "Saliendo."
                    return 1
                    ;;

                *)
                    warning "Opción no válida."
                    ;;

            esac

        done
    done
}

# ============================================================
# Principal
# ============================================================

main() {

    check_dependencies

    load_config

    while true; do

        # ----------------------------------------------------
        # URL
        # ----------------------------------------------------

        ask_url

        # ----------------------------------------------------
        # Información
        # ----------------------------------------------------

        if ! get_video_info; then

            echo
            echo "¿Deseas introducir otro enlace?"
            echo
            echo "  1) Sí"
            echo "  2) Salir"
            echo

            read -r -p "Selecciona [1-2]: " choice

            if [[ "$choice" != "1" ]]; then
                exit 1
            fi

            continue
        fi

        # ----------------------------------------------------
        # Calidad
        # ----------------------------------------------------

        detect_4k

        select_quality

        # ----------------------------------------------------
        # Playlist
        # ----------------------------------------------------

        detect_playlist

        show_playlist_selection

        # ----------------------------------------------------
        # Resumen
        # ----------------------------------------------------

        echo
        echo -e "${BOLD}Configuración de descarga${RESET}"
        echo "----------------------------------------"

        if [[ "$PLAYLIST_MODE" == "playlist" ]]; then
            echo "Modo   : playlist"
        else
            echo "Modo   : vídeo individual"
        fi

        echo "Vídeo  : ${VIDEO_HEIGHT}p"
        echo "Audio  : ${DEFAULT_AUDIO}"
        echo "Destino: ${DOWNLOAD_DIR}"

        echo "----------------------------------------"
        echo

        # ----------------------------------------------------
        # Descargar
        # ----------------------------------------------------

        if download_loop; then

            echo

            read -r -p "¿Descargar otro vídeo? [S/n]: " another

            case "${another,,}" in

                ""|s|si|sí)
                    clear
                    continue
                    ;;

                n|no)
                    success "Hasta luego."
                    exit 0
                    ;;

                *)
                    success "Hasta luego."
                    exit 0
                    ;;

            esac

        else

            exit 1

        fi

    done
}

main "$@"

